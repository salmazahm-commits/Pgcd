#include <stdio.h>

int main() {
    int i, j;
    int estPremier;

    printf("Les nombres premiers de 2 à 100 sont :\n");

    for (i = 2; i <= 100; i++) {
        estPremier = 1;   // on suppose que i est premier

        for (j = 2; j <= i / 2; j++) {
            if (i % j == 0) {
                estPremier = 0;  // i n'est pas premier
                break;
            }
        }

        if (estPremier == 1) {
            printf("%d ", i);
        }
    }

    return 0;
}
