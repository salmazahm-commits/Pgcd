# tester si un nombre est premier ou non .
#include <stdio.h>

int main()
{
    int A, i;
    int estPremier = 1;   

    printf("Entrer un entier A : ");
    scanf("%d", &A);

    if (A <= 1)
    {
        estPremier = 0;
    }
    else
    {
        // Test de divisibilité
        for (i = 2; i < A; i++)
        {
            if (A % i == 0)
            {
                estPremier = 0;
                break;
            }
        }
    }
    if (estPremier == 1)
        printf("%d est un nombre premier.\n", A);
    else
        printf("%d n'est pas un nombre premier.\n", A);

    return 0;
}
