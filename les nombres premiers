# tester si un nombre est premier ou non .

#include <stdio.h>

int main() {
    int A, i;

    printf("Entrez un nombre A : ");
    scanf("%d", &A);

    if (A <= 1) {
        printf("%d n'est pas un nombre premier.\n", A);
        return 0;
    }

    for (i = 2; i <= A / 2; i++) {
        if (A % i == 0) {
            printf("%d n'est pas un nombre premier.\n", A);
            return 0;
        }
    }

    printf("%d est un nombre premier.\n", A);
    return 0;
}
